{
  "name": "kvb-snooker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui && tsc --noEmit -p src/render && tsc --noEmit -p src/controller && tsc --noEmit -p src/audio",
    "demo": "tsc --noEmit false --outDir .cache/demo && node .cache/demo/src/core/demo.js",
    "net:server": "tsc -p tsconfig.server.json && node .cache/net-server/server/main.js",
    "identity:build": "tsc -p tsconfig.identity.json",
    "identity:migrate": "npm run identity:build && node .cache/identity/identity/cli.js migrate",
    "identity:create-user": "npm run identity:build && node .cache/identity/identity/cli.js create-user",
    "identity:reset-password": "npm run identity:build && node .cache/identity/identity/cli.js reset-password",
    "identity:disable-user": "npm run identity:build && node .cache/identity/identity/cli.js disable-user",
    "identity:enable-user": "npm run identity:build && node .cache/identity/identity/cli.js enable-user",
    "identity:list-users": "npm run identity:build && node .cache/identity/identity/cli.js list-users",
    "identity:dev": "npm run identity:build && node .cache/identity/identity/main.js",
    "deploy:check": "node scripts/deploy-check.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "assets:prepare": "node scripts/prepare-render-assets.mjs",
    "test:render": "node scripts/render-smoke.mjs",
    "test:controller": "node scripts/controller-smoke.mjs",
    "test:practice": "node scripts/practice-smoke.mjs",
    "test:my-shapes": "node scripts/my-shapes-smoke.mjs",
    "test:menu": "node scripts/menu-smoke.mjs",
    "test:mode-switch": "node scripts/mode-switch-smoke.mjs",
    "test:identity": "vitest run tests/identity",
    "test:identity:browser": "npm run build && npm run identity:build && node scripts/identity-smoke.mjs",
    "test:gunsight": "node scripts/gunsight-smoke.mjs",
    "test:camera": "node scripts/camera-smoke.mjs",
    "test:camera:ai": "node scripts/ai-camera-smoke.mjs",
    "test:rules": "node scripts/rules-test-smoke.mjs",
    "test:replay": "node scripts/replay-smoke.mjs",
    "test:replay:audio": "node scripts/replay-audio-smoke.mjs",
    "test:900": "node scripts/nine-hundred-smoke.mjs",
    "test:net": "node scripts/net-smoke.mjs",
    "audio:prepare": "node scripts/prepare-audio-assets.mjs",
    "audio:review": "node scripts/audio-review.mjs",
    "audio:final": "node scripts/audio-final-set.mjs",
    "audio:install": "node scripts/audio-final-set.mjs --install",
    "audio:cut": "node scripts/audio-cut.mjs",
    "test:audio": "node scripts/audio-smoke.mjs",
    "test:pause": "node scripts/pause-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "playwright-core": "1.62.1",
    "typescript": "^5.6.0",
    "vite": "5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "babylonjs": "3.2.0",
    "pg": "^8.23.1"
  }
}
