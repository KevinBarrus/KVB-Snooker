{
  "name": "kvb-snooker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui && tsc --noEmit -p src/render && tsc --noEmit -p src/controller",
    "demo": "tsc --noEmit false --outDir .cache/demo && node .cache/demo/src/core/demo.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "assets:prepare": "node scripts/prepare-render-assets.mjs",
    "test:render": "node scripts/render-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "1.62.1",
    "typescript": "^5.6.0",
    "vite": "5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "babylonjs": "3.2.0"
  }
}
