# 本地演练环境：复制为 deploy/dev.env 后填写本机占位值。
#   cp deploy/dev.env.example deploy/dev.env
# 真实文件已被 deploy/.gitignore 忽略，不提交；不要复用生产密码。
# 该 env 文件由 deploy/docker-compose.dev.yml 的 postgres 服务与本机身份服务进程读取。

POSTGRES_USER=snk
POSTGRES_PASSWORD=CHANGE_ME_仅本机
POSTGRES_DB=snk

# 本地 compose override 将 PostgreSQL 映射到 127.0.0.1:55433（仅回环地址）。
DATABASE_URL=postgres://snk:CHANGE_ME_仅本机@127.0.0.1:55433/snk

# 本地 Vite（5173）经 deploy/vite.local.config.mjs 把 /api 反代到 127.0.0.1:8788；
# 身份服务的同源校验以浏览器来源为准，所以这里是 Vite 地址。
PUBLIC_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=0
SESSION_TTL_SECONDS=604800
TRUST_PROXY=0
