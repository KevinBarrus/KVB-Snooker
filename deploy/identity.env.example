# 原生 Node 部署环境（复制到 /etc/kvb-snooker/identity.env，chmod 600，不要提交）。
HOST=127.0.0.1
PORT=8788
DATABASE_URL=postgres://kvb:CHANGE_ME@127.0.0.1:5432/kvb
STATIC_DIR=/opt/kvb-snooker/dist
MIGRATIONS_DIR=/opt/kvb-snooker/db/migrations
PUBLIC_ORIGIN=https://CHANGE_ME.example.com
COOKIE_SECURE=1
SESSION_TTL_SECONDS=604800
TRUST_PROXY=1
# 仅未来内网服务需要会话校验时设置；Caddy 已屏蔽 /api/internal/*。
# INTERNAL_TOKEN=CHANGE_ME
