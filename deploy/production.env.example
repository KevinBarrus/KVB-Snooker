# 生产部署环境：复制为 deploy/production.env 后填写真实值。
#   cp deploy/production.env.example deploy/production.env
#   chmod 600 deploy/production.env
# 真实文件已被 deploy/.gitignore 忽略，不提交；除本文件外不要另存密码。
# 该 env 文件由 docker compose 的 postgres、identity、caddy 服务读取。

# --- PostgreSQL（postgres 官方镜像首次初始化时使用）---
POSTGRES_USER=snk
POSTGRES_PASSWORD=CHANGE_ME_强随机密码
POSTGRES_DB=snk

# --- 身份服务 ---
# compose 内部主机名固定为 postgres；密码片段必须与上面 POSTGRES_PASSWORD 完全一致。
DATABASE_URL=postgres://snk:CHANGE_ME_强随机密码@postgres:5432/snk
# 浏览器访问的公开同源地址；Caddy 以其作为站点地址并申请证书。
PUBLIC_ORIGIN=https://CHANGE_ME.example.com
# 生产必须为 1，Cookie 带 Secure。
COOKIE_SECURE=1
# 会话有效期（秒），默认 604800（7 天）。
SESSION_TTL_SECONDS=604800
# 经 Caddy 反代时设为 1，登录限流才按真实来源 IP 计数。
TRUST_PROXY=1
# 仅当未来内网服务需要会话校验端点时设置；公开反代已屏蔽 /api/internal/*。
# INTERNAL_TOKEN=CHANGE_ME_长随机令牌
